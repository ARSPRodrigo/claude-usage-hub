{
  "name": "claude-usage-hub",
  "version": "0.4.0-beta",
  "private": true,
  "description": "Team-wide Claude Code usage monitoring tool",
  "scripts": {
    "start": "pnpm build && tsx packages/cli/src/cli.ts start",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "e2e:build": "docker build -t claude-usage-hub:latest .",
    "e2e:up": "docker compose -f packages/e2e/docker-compose.e2e.yml up -d --wait",
    "e2e:down": "docker compose -f packages/e2e/docker-compose.e2e.yml down -v",
    "e2e": "pnpm --filter @claude-usage-hub/e2e test",
    "e2e:ui": "pnpm --filter @claude-usage-hub/e2e test:ui",
    "e2e:ci": "pnpm e2e:build && pnpm e2e:up && pnpm e2e; EXIT=$?; pnpm e2e:down; exit $EXIT"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
